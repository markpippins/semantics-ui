# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── Nexus UI runtime configuration (copy this block into `.env`) ────────
# The `.env` file (git-ignored) is the live runtime config; `.env.example`
# documents the available variables. Copy this file to `.env` and adjust.

# SEMANTICS_UI_LIVE_MODE: Mode selector.
#   true  → LIVE: proxy all /api/* to SEMANTICS_SRV_URL (real backend).
#   false → MOCK (default): serve in-memory seed data from server.ts.
SEMANTICS_UI_LIVE_MODE=false

# SEMANTICS_SRV_URL: Real semantics-srv backend URL (used only when
# SEMANTICS_UI_LIVE_MODE=true). The real semantics-srv implements the
# identical /api/* REST surface as the in-process mock, so the React
# frontend's bare fetch('/api/...') calls work unchanged.
# Default: http://localhost:3160 (canonical semantics-srv port).
# SEMANTICS_SRV_URL=http://localhost:3160

# PORT: Override the listen port for ad-hoc runs.
#   Mock mode defaults to 3000 (Google AI Studio convention).
#   Live mode defaults to 4213 (next free in nexus 4200+ UI range).
# PORT=3000

# DISABLE_HMR: Set to 'true' to disable Vite's HMR + file-watch. Recommended
# under systemd so file edits by agents/editors don't churn Vite's dev
# server. Default: false (HMR on) when unset.
# DISABLE_HMR=true
